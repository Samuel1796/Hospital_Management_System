<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" style="-fx-padding: 30;" 
      xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.healthcaremanagementsystem.controller.InventoryController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT">
        <Label text="Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Main Content: Form and Table -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">
        
        <!-- Form Section -->
        <VBox spacing="15" prefWidth="300" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="Item Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            
            <VBox spacing="5">
                <Label text="Item Name" />
                <TextField fx:id="txtItemName" promptText="Enter item name" />
            </VBox>
            
            <VBox spacing="5">
                <Label text="Stock Quantity" />
                <TextField fx:id="txtStockQuantity" promptText="Enter quantity" />
            </VBox>
            
            <VBox spacing="5">
                <Label text="Price" />
                <TextField fx:id="txtPrice" promptText="Enter price" />
            </VBox>
            
            <VBox spacing="5">
                <Label text="Expiry Date" />
                <DatePicker fx:id="dpExpiryDate" maxWidth="Infinity" />
            </VBox>

            <Separator style="-fx-padding: 10 0;" />

            <VBox spacing="10">
                <HBox spacing="8">
                    <Button text="Add Item" onAction="#addItem" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                            style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #152d4a; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button text="Update" onAction="#updateItem" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                            style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #37474f; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button text="Delete" onAction="#deleteItem" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                            style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #b71c1c; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button text="Clear" onAction="#clearForm" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-border-color: #cfd8dc; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-radius: 3; -fx-border-width: 1;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Table Section -->
        <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="10">
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colItemName" text="Item Name" prefWidth="200" />
                    <TableColumn fx:id="colStockQuantity" text="Quantity" prefWidth="100" />
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
                    <TableColumn fx:id="colExpiryDate" text="Expiry Date" prefWidth="150" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            
            <!-- Pagination Controls -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                 <Button fx:id="btnPrevPage" text="Previous" onAction="#handlePrevPage"
                        style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-text-fill: #546e7a; -fx-background-radius: 3; -fx-border-radius: 3; -fx-cursor: hand;"/>
                 <Label fx:id="lblPageInfo" text="Page 1 of 1" style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"/>
                 <Button fx:id="btnNextPage" text="Next" onAction="#handleNextPage"
                        style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-text-fill: #546e7a; -fx-background-radius: 3; -fx-border-radius: 3; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>
