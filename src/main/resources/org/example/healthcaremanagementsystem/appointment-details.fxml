<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.healthcaremanagementsystem.controller.AppointmentDetailsController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: #f5f7fa;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Appointment Details &amp; Clinical Workflow" 
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblAppointmentId" text="ID: #" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
    </HBox>

    <Separator />

    <!-- Appointment Info Card -->
    <GridPane hgap="20" vgap="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <Label text="Patient Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
        <Label fx:id="lblPatientName" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 14px;"/>

        <Label text="Doctor Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
        <Label fx:id="lblDoctorName" text="--" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-size: 14px;"/>

        <Label text="Date &amp; Time:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
        <Label fx:id="lblDateTime" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 14px;"/>

        <Label text="Type:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
        <Label fx:id="lblType" text="--" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-font-size: 14px;"/>

        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
        <Label fx:id="lblStatus" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
    </GridPane>

    <!-- Clinical Actions Split View -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Prescription Section -->
        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="Add Prescription" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            
            <GridPane hgap="10" vgap="10">
                <Label text="Medication (from Inventory):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="comboMedication" promptText="Select Medication" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

                <Label text="Dosage:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDosage" promptText="e.g. 500mg" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Frequency:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtFrequency" promptText="e.g. 2 times daily" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Duration:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtDuration" promptText="e.g. 5 days" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <Button text="Save Prescription" onAction="#handleSavePrescription" maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

        <!-- Medical Log Section -->
        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="Add Medical Record" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            
            <VBox spacing="5">
                <Label text="Diagnosis / Clinical Notes:" />
                <TextArea fx:id="txtNotes" promptText="Enter detailed clinical notes here..." wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Button text="Save Medical Log" onAction="#handleSaveMedicalLog" maxWidth="Infinity"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

    </HBox>

    <!-- Footer Actions -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Complete Appointment" fx:id="btnComplete" onAction="#handleCompleteAppointment"
                style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="Close" onAction="#handleClose"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>
