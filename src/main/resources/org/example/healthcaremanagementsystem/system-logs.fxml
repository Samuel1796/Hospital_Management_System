<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 20;" 
      xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.healthcaremanagementsystem.controller.SystemLogsController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="System Logs" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh" onAction="#refreshLogs" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
    </HBox>

    <ListView fx:id="listSystemLogs" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Consolas', monospace;"/>

</VBox>
