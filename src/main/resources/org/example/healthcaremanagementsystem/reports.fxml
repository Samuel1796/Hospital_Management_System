<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            style="-fx-background-color: #f8f9fa;">
    
    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24;">
                <VBox>
                    <Label text="Reports" style="-fx-text-fill: #263238; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="Generate and export system reports" style="-fx-text-fill: #78909c; -fx-font-size: 12px; -fx-padding: 2 0 0 0;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="16" style="-fx-padding: 40;">
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 40; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <Label text="Reports Module" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                <Label text="Comprehensive reporting and export functionality" style="-fx-text-fill: #78909c; -fx-font-size: 13px;"/>
                <Label text="Available in future release" style="-fx-text-fill: #90a4ae; -fx-font-size: 11px; -fx-padding: 8 0 0 0;"/>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
