<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.AppointmentController"
            style="-fx-background-color: #f8f9fa;">
    
    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24;">
                <VBox>
                    <Label text="Appointment Management" style="-fx-text-fill: #263238; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="Schedule and manage patient appointments" style="-fx-text-fill: #78909c; -fx-font-size: 12px; -fx-padding: 2 0 0 0;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <!-- Form Panel -->
    <left>
        <VBox prefWidth="340" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">
            <ScrollPane fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
                <VBox spacing="16" style="-fx-padding: 20;">
                    <Label text="Appointment Details" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    
                    <VBox spacing="4">
                        <Label text="Patient *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <HBox spacing="8">
                            <TextField fx:id="txtSelectedPatient" editable="false" promptText="No patient selected" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #f5f5f5; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                            <Button fx:id="btnSelectPatient" text="Select..." prefWidth="80" onAction="#selectPatient"
                                    style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Doctor *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <HBox spacing="8">
                            <TextField fx:id="txtSelectedDoctor" editable="false" promptText="No doctor selected" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #f5f5f5; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                            <Button fx:id="btnSelectDoctor" text="Select..." prefWidth="80" onAction="#selectDoctor"
                                    style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                    
                    <Separator style="-fx-padding: 4 0;"/>
                    
                    <Label text="Schedule" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Date *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="datePickerAppointmentDate" promptText="Select date" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="120">
                            <Label text="Time *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="comboAppointmentTime" maxWidth="1.7976931348623157E308" promptText="Select time"/>
                        </VBox>
                    </HBox>
                    
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Type *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="comboAppointmentType" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="120">
                            <Label text="Status" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="comboStatus" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>
                    
                    <VBox spacing="4">
                        <Label text="Notes" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextArea fx:id="txtNotes" promptText="Additional notes..." prefRowCount="4"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                    </VBox>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="8" style="-fx-padding: 12 0 0 0;">
                        <Button fx:id="btnCreate" text="Schedule" prefWidth="80" prefHeight="32"
                                style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnUpdate" text="Update" prefWidth="70" prefHeight="32" disable="true"
                                style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnDelete" text="Cancel" prefWidth="70" prefHeight="32" disable="true"
                                style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnClear" text="Clear" prefWidth="60" prefHeight="32" onAction="#clearForm"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <!-- Data Table -->
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <TextField fx:id="txtSearch" prefWidth="300" promptText="Search by patient or doctor name..." 
                           style="-fx-background-color: #f5f5f5; -fx-border-color: transparent; -fx-background-radius: 3; -fx-padding: 8 12;"/>
                <Button fx:id="btnSearch" text="Search" prefHeight="32" onAction="#searchAppointments"
                        style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 0 16; -fx-background-radius: 3; -fx-cursor: hand;"/>
                <Button fx:id="btnClearSearch" text="Reset" prefHeight="32" onAction="#clearSearch"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-padding: 0 16; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>
            
            <!-- Table -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <Label text="Appointment Schedule" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                </HBox>
                <TableView fx:id="tableViewAppointments" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colAppointmentId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colPatientName" text="Patient" prefWidth="140"/>
                        <TableColumn fx:id="colDoctorName" text="Doctor" prefWidth="140"/>
                        <TableColumn fx:id="colAppointmentDate" text="Date &amp; Time" prefWidth="140"/>
                        <TableColumn fx:id="colAppointmentType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
