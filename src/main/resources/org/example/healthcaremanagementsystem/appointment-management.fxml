<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.AppointmentController"
            style="-fx-background-color: #fafafa;">
    
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 0, 0, 0, 1);">
            <Label text="Appointment Management" style="-fx-text-fill: #1a1a1a; -fx-font-size: 28px; -fx-font-weight: 600;"/>
            <Label text="Schedule and manage patient-doctor appointments" style="-fx-text-fill: #6b7280; -fx-font-size: 14px; -fx-padding: 4 0 0 0;"/>
        </VBox>
    </top>
    
    <left>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0;">
            <VBox spacing="20" style="-fx-padding: 24; -fx-min-width: 320; -fx-background-color: #ffffff;">
                <Label text="Appointment Information" style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                
                <GridPane hgap="12" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                        <ColumnConstraints minWidth="180" prefWidth="180"/>
                    </columnConstraints>
                    
                    <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboPatient" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                              style="-fx-background-radius: 6;"/>
                    
                    <Label text="Doctor:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboDoctor" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                              style="-fx-background-radius: 6;"/>
                    
                    <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <DatePicker fx:id="datePickerAppointmentDate" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                                promptText="Select date" style="-fx-background-radius: 6;"/>
                    
                    <Label text="Time:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboAppointmentTime" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                              style="-fx-background-radius: 6;"/>
                    
                    <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboAppointmentType" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                              style="-fx-background-radius: 6;"/>
                    
                    <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboStatus" GridPane.columnIndex="1" GridPane.rowIndex="5" 
                              style="-fx-background-radius: 6;"/>
                    
                    <Label text="Notes:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    <TextArea fx:id="txtNotes" GridPane.columnIndex="1" GridPane.rowIndex="6" prefRowCount="4" 
                              style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #d1d5db; -fx-padding: 8 12;"/>
                </GridPane>
                
                <VBox spacing="10" style="-fx-padding: 8 0 0 0;">
                    <HBox spacing="8">
                        <Button fx:id="btnCreate" text="Create" prefWidth="70" prefHeight="36"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnUpdate" text="Update" prefWidth="70" prefHeight="36"
                                style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;" disable="true"/>
                        <Button fx:id="btnDelete" text="Delete" prefWidth="70" prefHeight="36"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;" disable="true"/>
                        <Button fx:id="btnClear" text="Clear" prefWidth="70" prefHeight="36"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;"
                                onAction="#clearForm"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>
    
    <center>
        <VBox spacing="16" style="-fx-padding: 24;">
            <!-- Search Section -->
            <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);">
                <Label text="Search Appointments" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" prefWidth="400" promptText="Search by patient or doctor name..." 
                               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #d1d5db; -fx-padding: 10 14;"/>
                    <Button fx:id="btnSearch" text="Search" prefHeight="36" prefWidth="90"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;"
                            onAction="#searchAppointments"/>
                    <Button fx:id="btnClearSearch" text="Clear" prefHeight="36" prefWidth="70"
                            style="-fx-background-color: #9ca3af; -fx-text-fill: white; -fx-font-weight: 500; -fx-background-radius: 6; -fx-cursor: hand;"
                            onAction="#clearSearch"/>
                </HBox>
            </VBox>
            
            <!-- Appointments Table -->
            <VBox spacing="8">
                <Label text="Appointment List" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                <TableView fx:id="tableViewAppointments" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);">
                    <columns>
                        <TableColumn fx:id="colAppointmentId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPatientName" text="Patient" prefWidth="160"/>
                        <TableColumn fx:id="colDoctorName" text="Doctor" prefWidth="160"/>
                        <TableColumn fx:id="colAppointmentDate" text="Date &amp; Time" prefWidth="160"/>
                        <TableColumn fx:id="colAppointmentType" text="Type" prefWidth="130"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
