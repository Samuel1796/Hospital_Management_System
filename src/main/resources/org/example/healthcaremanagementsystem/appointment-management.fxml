<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            style="-fx-background-color: #f5f5f5;">
    
    <top>
        <VBox style="-fx-background-color: #e74c3c; -fx-padding: 15;">
            <Label text="Appointment Management" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
