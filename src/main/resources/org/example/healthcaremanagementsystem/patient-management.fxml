<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.PatientController"
            style="-fx-background-color: #f5f5f5;">
    
    <top>
        <VBox style="-fx-background-color: #3498db; -fx-padding: 15;">
            <Label text="Patient Management" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <left>
        <VBox spacing="15" style="-fx-padding: 20; -fx-min-width: 250;">
            <Label text="Patient Information" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="170"/>
                </columnConstraints>
                
                <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtFirstName" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtLastName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                
                <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPhoneNumber" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                
                <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <DatePicker fx:id="datePickerDateOfBirth" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="DD/MM/YYYY"/>
                
                <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="comboGender" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="200"/>
                
                <Label text="Blood Group:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <ComboBox fx:id="comboBloodGroup" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="200"/>
                
                <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextArea fx:id="txtAddress" GridPane.columnIndex="1" GridPane.rowIndex="7" prefRowCount="3"/>
                
                <Label text="Emergency Contact:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextField fx:id="txtEmergencyContact" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                
                <Label text="Emergency Phone:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                <TextField fx:id="txtEmergencyPhone" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
            </GridPane>
            
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnCreate" text="Create" prefWidth="80" 
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                <Button fx:id="btnUpdate" text="Update" prefWidth="80" 
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;" disable="true"/>
                <Button fx:id="btnDelete" text="Delete" prefWidth="80" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;" disable="true"/>
                <Button fx:id="btnClear" text="Clear" prefWidth="80" 
                        onAction="#clearForm"/>
            </HBox>
        </VBox>
    </left>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <!-- Search Section -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="Search Patients" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" prefWidth="400" promptText="Search by name..."/>
                    <Button fx:id="btnSearch" text="Search" onAction="#searchPatients"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button fx:id="btnClearSearch" text="Clear Search" onAction="#clearSearch"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                </HBox>
            </VBox>
            
            <!-- Patients Table -->
            <Label text="Patient List" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TableView fx:id="tableViewPatients" style="-fx-background-color: white;">
                <columns>
                    <TableColumn fx:id="colPatientId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="120"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="120"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    
</BorderPane>

