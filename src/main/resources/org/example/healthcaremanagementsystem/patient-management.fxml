<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.PatientController"
            style="-fx-background-color: #f8f9fa;">
    
    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24;">
                <VBox>
                    <Label text="Patient Management" style="-fx-text-fill: #263238; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="Register and manage patient records" style="-fx-text-fill: #78909c; -fx-font-size: 12px; -fx-padding: 2 0 0 0;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <!-- Form Panel -->
    <left>
        <VBox prefWidth="340" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">
            <ScrollPane fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
                <VBox spacing="16" style="-fx-padding: 20;">
                    <Label text="Patient Details" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    
                    <VBox spacing="4">
                        <Label text="First Name *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtFirstName" promptText="Enter first name" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Last Name *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtLastName" promptText="Enter last name" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Email Address *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmail" promptText="email@example.com" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Phone Number *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtPhoneNumber" promptText="0244XXXXXXX" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Date of Birth *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="datePickerDateOfBirth" promptText="Select date" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="100">
                            <Label text="Gender" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="comboGender" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </HBox>
                    
                    <VBox spacing="4">
                        <Label text="Blood Group" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="comboBloodGroup" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Address" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextArea fx:id="txtAddress" promptText="Full address" prefRowCount="2"
                                  style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                    </VBox>
                    
                    <Separator style="-fx-padding: 4 0;"/>
                    
                    <Label text="Emergency Contact" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    
                    <VBox spacing="4">
                        <Label text="Contact Name" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmergencyContact" promptText="Emergency contact name" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Contact Phone" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmergencyPhone" promptText="0244XXXXXXX" 
                                   style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8 10;"/>
                    </VBox>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="8" style="-fx-padding: 12 0 0 0;">
                        <Button fx:id="btnCreate" text="Save" prefWidth="70" prefHeight="32"
                                style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnUpdate" text="Update" prefWidth="70" prefHeight="32" disable="true"
                                style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnDelete" text="Delete" prefWidth="70" prefHeight="32" disable="true"
                                style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnClear" text="Clear" prefWidth="70" prefHeight="32" onAction="#clearForm"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
                        <Button fx:id="btnHistory" text="History" prefWidth="70" prefHeight="32" disable="true"
                                style="-fx-background-color: #5e35b1; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 3; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <!-- Data Table -->
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <TextField fx:id="txtSearch" prefWidth="300" promptText="Search patients by name or ID..." 
                           style="-fx-background-color: #f5f5f5; -fx-border-color: transparent; -fx-background-radius: 3; -fx-padding: 8 12;"/>
                <Button fx:id="btnSearch" text="Search" prefHeight="32" onAction="#searchPatients"
                        style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 0 16; -fx-background-radius: 3; -fx-cursor: hand;"/>
                <Button fx:id="btnClearSearch" text="Reset" prefHeight="32" onAction="#clearSearch"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-padding: 0 16; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>
            
            <!-- Table -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <Label text="Patient Records" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRecordInfo" text="0 records" style="-fx-text-fill: #78909c; -fx-font-size: 12px;"/>
                </HBox>
                <TableView fx:id="tableViewPatients" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colPatientId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colFirstName" text="First Name" prefWidth="120"/>
                        <TableColumn fx:id="colLastName" text="Last Name" prefWidth="120"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                        <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
                    </columns>
                </TableView>
                
                <!-- Pagination Controls -->
                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 12 16; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                    <Button fx:id="btnFirstPage" text="«" prefWidth="32" prefHeight="28"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"
                            onAction="#goToFirstPage"/>
                    <Button fx:id="btnPrevPage" text="‹" prefWidth="32" prefHeight="28"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"
                            onAction="#goToPreviousPage"/>
                    <Label fx:id="lblPageInfo" text="Page 1 of 1" style="-fx-text-fill: #263238; -fx-font-size: 12px; -fx-padding: 0 12;"/>
                    <Button fx:id="btnNextPage" text="›" prefWidth="32" prefHeight="28"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"
                            onAction="#goToNextPage"/>
                    <Button fx:id="btnLastPage" text="»" prefWidth="32" prefHeight="28"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-font-size: 12px; -fx-border-color: #cfd8dc; -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"
                            onAction="#goToLastPage"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Records per page:" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="comboPageSize" prefWidth="70" onAction="#changePageSize"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
