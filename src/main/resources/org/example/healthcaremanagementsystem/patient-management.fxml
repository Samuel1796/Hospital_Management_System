<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f8f9fa;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.healthcaremanagementsystem.controller.PatientController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Patient Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Register and manage patient records" style="-fx-text-fill: #78909c; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Main Content: Form and Table -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- Form Section -->
        <VBox spacing="15" prefWidth="320" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <ScrollPane fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: transparent;" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <VBox spacing="10" style="-fx-background-color: #ffffff;">
                    <Label text="Patient Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                    <VBox spacing="5">
                        <Label text="First Name *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtFirstName" promptText="Enter first name" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Last Name *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtLastName" promptText="Enter last name" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Email *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmail" promptText="email@example.com" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Phone *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtPhoneNumber" promptText="0244XXXXXXX" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="DOB *" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <DatePicker fx:id="datePickerDateOfBirth" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" prefWidth="100">
                            <Label text="Gender" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                            <ComboBox fx:id="comboGender" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Blood Group" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="comboBloodGroup" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Address" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextArea fx:id="txtAddress" promptText="Full address" prefRowCount="2"/>
                    </VBox>

                    <Separator style="-fx-padding: 5 0;"/>
                    <Label text="Emergency Contact" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>

                    <VBox spacing="5">
                        <Label text="Name" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmergencyContact" promptText="Contact name" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Phone" style="-fx-text-fill: #546e7a; -fx-font-size: 11px;"/>
                        <TextField fx:id="txtEmergencyPhone" promptText="0244XXXXXXX" />
                    </VBox>
                </VBox>
            </ScrollPane>
            <VBox spacing="10">
                <HBox spacing="8">
                    <Button fx:id="btnCreate" text="Save" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #152d4a; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button fx:id="btnUpdate" text="Update" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #37474f; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button fx:id="btnDelete" text="Delete" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #b71c1c; -fx-border-width: 1; -fx-border-radius: 3;"/>
                    <Button fx:id="btnClear" text="Clear" onAction="#clearForm" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-border-color: #cfd8dc; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-radius: 3; -fx-border-width: 1;"/>
                </HBox>
                <Button fx:id="btnHistory" text="View History" disable="true" maxWidth="Infinity"
                        style="-fx-background-color: #5e35b1; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-color: #4527a0; -fx-border-width: 1; -fx-border-radius: 3;"/>
            </VBox>
        </VBox>

        <!-- Table Section -->
        <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="10">

            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);">
                <TextField fx:id="txtSearch" promptText="Search patients by name or ID..." HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;"/>
                <Button fx:id="btnSearch" text="Search" onAction="#searchPatients"
                        style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3;"/>
                <Button fx:id="btnClearSearch" text="Reset" onAction="#clearSearch"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #546e7a; -fx-border-color: #cfd8dc; -fx-cursor: hand; -fx-background-radius: 3; -fx-border-radius: 3;"/>
            </HBox>

            <TableView fx:id="tableViewPatients" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="colPatientId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="120"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="120"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Pagination Controls -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 5 0 0 0;">
                <Button fx:id="btnFirstPage" text="«" onAction="#goToFirstPage" style="-fx-cursor: hand;"/>
                <Button fx:id="btnPrevPage" text="‹" onAction="#goToPreviousPage" style="-fx-cursor: hand;"/>
                <Label fx:id="lblPageInfo" text="Page 1 of 1" style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"/>
                <Button fx:id="btnNextPage" text="›" onAction="#goToNextPage" style="-fx-cursor: hand;"/>
                <Button fx:id="btnLastPage" text="»" onAction="#goToLastPage" style="-fx-cursor: hand;"/>

                <Region prefWidth="20"/>
                <Label text="Rows:" style="-fx-text-fill: #78909c;"/>
                <ComboBox fx:id="comboPageSize" prefWidth="70" onAction="#changePageSize"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblRecordInfo" text="0 records" style="-fx-text-fill: #78909c;"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>