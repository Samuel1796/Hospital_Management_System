<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.PerformanceController"
            style="-fx-background-color: #f8f9fa;">
    
    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 24;">
                <VBox>
                    <Label text="Performance Analytics" style="-fx-text-fill: #263238; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="System metrics and query optimization analysis" style="-fx-text-fill: #78909c; -fx-font-size: 12px; -fx-padding: 2 0 0 0;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f8f9fa; -fx-background-color: #f8f9fa;">
            <VBox spacing="16" style="-fx-padding: 20;">
                
                <!-- Statistics Cards -->
                <HBox spacing="16">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <Label text="Total Patients" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                        <Label fx:id="lblTotalPatients" text="0" style="-fx-text-fill: #263238; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 4 0;"/>
                        <Label text="Registered in system" style="-fx-text-fill: #90a4ae; -fx-font-size: 10px;"/>
                    </VBox>
                    
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <Label text="Total Appointments" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                        <Label fx:id="lblTotalAppointments" text="0" style="-fx-text-fill: #263238; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 4 0;"/>
                        <Label text="All time" style="-fx-text-fill: #90a4ae; -fx-font-size: 10px;"/>
                    </VBox>
                    
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <Label text="Active Doctors" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                        <Label fx:id="lblActiveDoctors" text="0" style="-fx-text-fill: #263238; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 4 0;"/>
                        <Label text="On staff" style="-fx-text-fill: #90a4ae; -fx-font-size: 10px;"/>
                    </VBox>
                    
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <Label text="Cache Hit Rate" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                        <Label fx:id="lblCacheHitRate" text="0%" style="-fx-text-fill: #1e3a5f; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 4 0;"/>
                        <Label text="Performance metric" style="-fx-text-fill: #90a4ae; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
                
                <!-- Chart Section -->
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                    <Label text="Appointments by Status" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238; -fx-padding: 0 0 12 0;"/>
                    <BarChart fx:id="chartAppointmentsByStatus" prefHeight="280">
                        <xAxis>
                            <CategoryAxis label="Status"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Count"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                
                <!-- Performance Metrics Table -->
                <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 16; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                        <Label text="Query Performance Metrics" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
                    </HBox>
                    <TableView fx:id="tableViewMetrics" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colMetricName" text="Metric" prefWidth="220"/>
                            <TableColumn fx:id="colBeforeOptimization" text="Before Optimization" prefWidth="160"/>
                            <TableColumn fx:id="colAfterOptimization" text="After Optimization" prefWidth="160"/>
                            <TableColumn fx:id="colImprovement" text="Improvement" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
                
            </VBox>
        </ScrollPane>
    </center>
    
</BorderPane>
