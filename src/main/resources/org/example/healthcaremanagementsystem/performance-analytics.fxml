<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.PerformanceController"
            style="-fx-background-color: #f5f5f5;">
    
    <top>
        <VBox style="-fx-background-color: #9b59b6; -fx-padding: 20;">
            <Label text="Performance &amp; Analytics Dashboard" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="System Performance Metrics and Query Optimization Analysis" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <!-- System Statistics -->
                <VBox spacing="10">
                    <Label text="System Statistics" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <HBox spacing="30">
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                            <Label text="Total Patients" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalPatients" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                            <Label text="Total Appointments" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalAppointments" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                            <Label text="Active Doctors" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                            <Label fx:id="lblActiveDoctors" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                            <Label text="Cache Hit Rate" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                            <Label fx:id="lblCacheHitRate" text="0%" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Appointments Chart -->
                <VBox spacing="10">
                    <Label text="Appointments by Status" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="chartAppointmentsByStatus" style="-fx-background-color: white;">
                        <xAxis>
                            <CategoryAxis label="Status"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Count"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                
                <!-- Performance Metrics Table -->
                <VBox spacing="10">
                    <Label text="Performance Optimization Metrics" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tableViewMetrics" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colMetricName" text="Metric" prefWidth="250"/>
                            <TableColumn fx:id="colBeforeOptimization" text="Before Optimization" prefWidth="200"/>
                            <TableColumn fx:id="colAfterOptimization" text="After Optimization" prefWidth="200"/>
                            <TableColumn fx:id="colImprovement" text="Improvement" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    
    <bottom>
        <VBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 15;">
            <Label text="Performance metrics demonstrate the impact of indexing and caching on query execution times" 
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 11px;"/>
        </VBox>
    </bottom>
    
</BorderPane>

