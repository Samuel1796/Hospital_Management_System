<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.MainController"
            style="-fx-background-color: #f5f5f5;">
    
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Healthcare Management System" style="-fx-text-fill: white;">
                <font>
                    <Font name="Arial" size="28" />
                </font>
            </Label>
            <Label text="Database-Driven Hospital Management Solution" style="-fx-text-fill: #ecf0f1;">
                <font>
                    <Font name="Arial" size="14" />
                </font>
            </Label>
        </VBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnPatientManagement" text="Patient Management" 
                            prefWidth="200" prefHeight="80"
                            style="-fx-font-size: 16px; -fx-background-color: #3498db; -fx-text-fill: white;"
                            onAction="#openPatientManagement"/>
                    <Label text="Manage patient records, search, and CRUD operations" 
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                </VBox>
                
                <VBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnDoctorManagement" text="Doctor Management" 
                            prefWidth="200" prefHeight="80"
                            style="-fx-font-size: 16px; -fx-background-color: #27ae60; -fx-text-fill: white;"
                            onAction="#openDoctorManagement"/>
                    <Label text="Manage doctor information and department assignments" 
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
            
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnAppointmentManagement" text="Appointment Management" 
                            prefWidth="200" prefHeight="80"
                            style="-fx-font-size: 16px; -fx-background-color: #e74c3c; -fx-text-fill: white;"
                            onAction="#openAppointmentManagement"/>
                    <Label text="Schedule and manage patient appointments" 
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                </VBox>
                
                <VBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnViewReports" text="Reports &amp; Analytics" 
                            prefWidth="200" prefHeight="80"
                            style="-fx-font-size: 16px; -fx-background-color: #9b59b6; -fx-text-fill: white;"
                            onAction="#openReports"/>
                    <Label text="View performance reports and analytics" 
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <bottom>
        <VBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 15;">
            <Label text="Healthcare Management System | Built with JavaFX, PostgreSQL, and JDBC"
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 11px;"/>
        </VBox>
    </bottom>
    
</BorderPane>

