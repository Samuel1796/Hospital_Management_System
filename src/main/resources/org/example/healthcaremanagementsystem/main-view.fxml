<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.MainController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f8f9fa;">
    
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="240" style="-fx-background-color: #1e3a5f; -fx-padding: 0;">
            
            <!-- Logo/Brand Area -->
            <VBox alignment="CENTER_LEFT" style="-fx-padding: 24 20; -fx-background-color: #152d4a;">
                <Label text="HMS" style="-fx-text-fill: #4fc3f7; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                <Label text="Hospital Management" style="-fx-text-fill: #b0bec5; -fx-font-size: 11px; -fx-padding: 2 0 0 0;"/>
            </VBox>
            
            <!-- Navigation Menu -->
            <VBox spacing="4" style="-fx-padding: 16 12;">
                <!-- Management Section -->
                <Label text="MANAGEMENT" style="-fx-text-fill: #607d8b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 8 8 4 8;"/>
                
                <Button fx:id="btnPatientManagement" text="Patients" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openPatientManagement"/>
                
                <Button fx:id="btnDoctorManagement" text="Doctors" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openDoctorManagement"/>
                
                <Button fx:id="btnAppointmentManagement" text="Appointments" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openAppointmentManagement"/>

                <Button fx:id="btnInventory" text="Inventory" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openInventory"/>
                
                <Separator style="-fx-background-color: #37474f; -fx-padding: 4 0; -fx-opacity: 0.5;"/>

                <!-- Clinical Section -->
                <Label text="CLINICAL" style="-fx-text-fill: #607d8b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 8 8 4 8;"/>

                <Button fx:id="btnConsultation" text="Consultations" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openConsultationDashboard"/>
                
                <!-- History Section -->
                <Label text="HISTORY" style="-fx-text-fill: #607d8b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 8 8 4 8;"/>
                
                <Button fx:id="btnPatientHistory" text="Patient History" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openPatientHistoryDashboard"/>
                        
                <Button fx:id="btnDoctorHistory" text="Doctor History" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openDoctorHistoryDashboard"/>

                <Separator style="-fx-background-color: #37474f; -fx-padding: 4 0; -fx-opacity: 0.5;"/>

                <!-- System Section -->
                <Label text="SYSTEM" style="-fx-text-fill: #607d8b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 8 8 4 8;"/>
                
                <Button fx:id="btnViewReports" text="Reports &amp; Metrics" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openReports"/>

                <Button fx:id="btnSystemLogs" text="System Logs" 
                        prefWidth="216" prefHeight="36" styleClass="sidebar-button"
                        onAction="#openSystemLogs"/>
            </VBox>
            
            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Footer -->
            <VBox style="-fx-padding: 16 20; -fx-background-color: #152d4a;">
                <Label text="PostgreSQL &amp; Mongo" style="-fx-text-fill: #607d8b; -fx-font-size: 10px;"/>
                <Label text="v1.1.0" style="-fx-text-fill: #455a64; -fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- Main Content Area -->
    <center>
        <VBox style="-fx-padding: 0;">
            
            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 16 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label text="Dashboard" style="-fx-text-fill: #263238; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Welcome" style="-fx-text-fill: #78909c; -fx-font-size: 13px;"/>
            </HBox>
            
            <!-- Dashboard Content -->
            <VBox spacing="20" style="-fx-padding: 24;">
                
                <!-- Stats Row -->
                <HBox spacing="16">
                    <VBox prefWidth="180" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                        <Label text="Patients" style="-fx-text-fill: #78909c; -fx-font-size: 12px;"/>
                        <Label fx:id="lblPatientCount" text="0" style="-fx-text-fill: #263238; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                        <Label text="Total registered" style="-fx-text-fill: #90a4ae; -fx-font-size: 11px;"/>
                    </VBox>
                    
                    <VBox prefWidth="180" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                        <Label text="Doctors" style="-fx-text-fill: #78909c; -fx-font-size: 12px;"/>
                        <Label fx:id="lblDoctorCount" text="0" style="-fx-text-fill: #263238; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                        <Label text="Active staff" style="-fx-text-fill: #90a4ae; -fx-font-size: 11px;"/>
                    </VBox>
                    
                    <VBox prefWidth="180" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                        <Label text="Appointments" style="-fx-text-fill: #78909c; -fx-font-size: 12px;"/>
                        <Label fx:id="lblAppointmentCount" text="0" style="-fx-text-fill: #263238; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                        <Label text="This month" style="-fx-text-fill: #90a4ae; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
                
                <!-- Quick Actions -->
                <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <Label text="Quick Actions" style="-fx-text-fill: #263238; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <HBox spacing="12">
                        <Button text="+ New Patient" prefHeight="36"
                                style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 20; -fx-background-radius: 4; -fx-cursor: hand;"
                                onAction="#openPatientManagement"/>
                        <Button text="+ New Appointment" prefHeight="36"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3a5f; -fx-font-size: 13px; -fx-padding: 0 20; -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-cursor: hand;"
                                onAction="#openAppointmentManagement"/>
                        <Button text="View Reports" prefHeight="36"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e3a5f; -fx-font-size: 13px; -fx-padding: 0 20; -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-cursor: hand;"
                                onAction="#openReports"/>
                    </HBox>
                </VBox>
                
                <!-- System Info -->
                <VBox spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <Label text="System Information" style="-fx-text-fill: #263238; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <HBox spacing="40">
                        <VBox spacing="4">
                            <Label text="Database" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                            <Label text="PostgreSQL" style="-fx-text-fill: #263238; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Framework" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                            <Label text="JavaFX 21" style="-fx-text-fill: #263238; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Architecture" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                            <Label text="MVC + DAO Pattern" style="-fx-text-fill: #263238; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Optimization" style="-fx-text-fill: #78909c; -fx-font-size: 11px;"/>
                            <Label text="Indexed + Cached" style="-fx-text-fill: #263238; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
    
</BorderPane>
