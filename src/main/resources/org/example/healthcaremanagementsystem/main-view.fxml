<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.healthcaremanagementsystem.controller.MainController"
            style="-fx-background-color: #fafafa;">
    
    <top>
        <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #ffffff; -fx-padding: 32 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 0, 0, 0, 2);">
            <Label text="Hospital Management System" style="-fx-text-fill: #1a1a1a; -fx-font-weight: 600;">
                <font>
                    <Font name="System" size="32" />
                </font>
            </Label>
            <Label text="Database-Driven Healthcare Solution" style="-fx-text-fill: #6b7280; -fx-font-size: 14;">
                <font>
                    <Font name="System" size="14" />
                </font>
            </Label>
        </VBox>
    </top>
    
    <center>
        <VBox alignment="CENTER" spacing="24" style="-fx-padding: 60 40;">
            <GridPane hgap="24" vgap="24" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="280" maxWidth="280"/>
                    <ColumnConstraints minWidth="280" maxWidth="280"/>
                </columnConstraints>
                
                <!-- Patient Management -->
                <VBox spacing="12" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 32; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Button fx:id="btnPatientManagement" text="Patient Management" 
                            prefWidth="240" prefHeight="64"
                            style="-fx-font-size: 16px; -fx-font-weight: 500; -fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                            onAction="#openPatientManagement"/>
                    <Label text="Manage patient records, search, and perform CRUD operations" 
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;"
                           maxWidth="220"/>
                </VBox>
                
                <!-- Doctor Management -->
                <VBox spacing="12" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 32; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Button fx:id="btnDoctorManagement" text="Doctor Management" 
                            prefWidth="240" prefHeight="64"
                            style="-fx-font-size: 16px; -fx-font-weight: 500; -fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                            onAction="#openDoctorManagement"/>
                    <Label text="Manage doctor information and department assignments" 
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;"
                           maxWidth="220"/>
                </VBox>
                
                <!-- Appointment Management -->
                <VBox spacing="12" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 32; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Button fx:id="btnAppointmentManagement" text="Appointment Management" 
                            prefWidth="240" prefHeight="64"
                            style="-fx-font-size: 16px; -fx-font-weight: 500; -fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                            onAction="#openAppointmentManagement"/>
                    <Label text="Schedule and manage patient-doctor appointments" 
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;"
                           maxWidth="220"/>
                </VBox>
                
                <!-- Reports & Analytics -->
                <VBox spacing="12" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 32; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Button fx:id="btnViewReports" text="Reports &amp; Analytics" 
                            prefWidth="240" prefHeight="64"
                            style="-fx-font-size: 16px; -fx-font-weight: 500; -fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                            onAction="#openReports"/>
                    <Label text="View performance reports, analytics, and system metrics" 
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;"
                           maxWidth="220"/>
                </VBox>
            </GridPane>
        </VBox>
    </center>
    
    <bottom>
        <VBox alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            <Label text="© 2024 Hospital Management System | PostgreSQL | JavaFX"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
        </VBox>
    </bottom>
    
</BorderPane>

